# Copy to .env and fill in. Never commit .env.
# TMS values come from packet/secret.txt.
TMS_API_BASE=
TMS_API_KEY=

# Model: "provider:model-name", or "fake" to run without a key (templated output).
MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Writes are dry-run unless DRY_RUN=0. Only the tools lead turns this off, for one planned real run.
DRY_RUN=1
# 1 = read from snapshots/ instead of the API (the app's sidebar also switches this).
DEMO_MODE=0

# Traffic for delay predictions (meridian/traffic.py). Free key: developer.tomtom.com. Empty = traffic skipped.
TOMTOM_API_KEY=
